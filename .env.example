# Server-only secrets. Never prefix these values with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Current model IDs are deployment configuration, not business logic.
# Choose image-input + Structured Outputs capable models available to your API project.
OPENAI_VISION_MODEL=
OPENAI_SYNTHESIS_MODEL=
OPENAI_IMAGE_DETAIL=original
OPENAI_REASONING_EFFORT=medium

# Informational declaration only. Setting zdr does not verify organisation eligibility.
OPENAI_DATA_MODE=standard

# Must decode to exactly 32 random bytes. Example generator:
# openssl rand -base64 32
IMAGE_ENCRYPTION_KEY=

# Add the Docker host's LAN IP or local DNS name before accessing from another device.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# openai is the production path. fake is explicit local test mode and is labelled in the UI.
ANALYSIS_GATEWAY=openai

DATABASE_PATH=data/reviewer.db
IMAGE_STORAGE_PATH=data/images

# Leave blank for manual purge only, or set a visible expiry in hours.
IMAGE_RETENTION_HOURS=

# Resource safeguards (all values are server enforced).
MAX_IMAGES_PER_REVIEW=10
MAX_IMAGE_BYTES=26214400
MAX_TOTAL_IMAGE_BYTES=104857600
MAX_IMAGE_PIXELS=80000000
MAX_IMAGE_WIDTH=20000
MAX_IMAGE_HEIGHT=20000
MAX_SANITIZED_IMAGE_BYTES=41943040
PREVIEW_MAX_WIDTH=1600
PREVIEW_MAX_HEIGHT=1200
MAX_PREVIEW_BYTES=4194304
MAX_CONTEXT_LENGTH=20000
MAX_CRITERIA_COUNT=30
MAX_JUDGEMENTS_PER_CRITERION=12
MODEL_REQUEST_TIMEOUT_MS=180000
MODEL_SCHEMA_RETRIES=2
MAX_OUTPUT_TOKENS_PER_PASS=16000
ANALYSIS_LEASE_MS=300000
